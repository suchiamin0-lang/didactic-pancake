{
  "mcpServers": {
    "gmail-personal": {
      "command": "npx",
      "args": ["-y", "@gongrzhe/server-gmail-autoauth-mcp"],
      "env": {
        "GMAIL_OAUTH_PATH": "${GMAIL_OAUTH_PATH}",
        "GMAIL_CREDENTIALS_PATH": "${GMAIL_PERSONAL_CREDENTIALS_PATH}"
      }
    },
    "gmail-work": {
      "command": "npx",
      "args": ["-y", "@gongrzhe/server-gmail-autoauth-mcp"],
      "env": {
        "GMAIL_OAUTH_PATH": "${GMAIL_OAUTH_PATH}",
        "GMAIL_CREDENTIALS_PATH": "${GMAIL_WORK_CREDENTIALS_PATH}"
      }
    }
  }
}
